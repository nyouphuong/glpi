{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./vendor/**)",
      "Read(./.venv/**)",
      "Read(./venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./out/**)",
      "Read(./target/**)",
      "Read(./obj/**)",
      "Read(./.next/**)",
      "Read(./.nuxt/**)",
      "Read(./coverage/**)",
      "Read(./.git/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.min.css)",
      "Read(./**/*.map)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./poetry.lock)",
      "Read(./Cargo.lock)",
      "Read(./composer.lock)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.env.local)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra governance..."
          }
        ]
      }
    ]
  }
}
